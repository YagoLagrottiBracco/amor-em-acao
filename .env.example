# ============================================================================
# CONFIGURAÇÃO DO SITE (SEO E DOMÍNIO CANÔNICO)
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://amoremacao.org

# ============================================================================
# SUPABASE (BLOG WYSIWYG, MISSÕES CMS, DOAÇÕES, VOLUNTARIADOS & LOGIN ADMIN)
# Obtenha em: Supabase Dashboard -> Project Settings -> API Keys
# Suporta tanto o novo padrão da Supabase (Publishable & Secret Keys)
# quanto as chaves legadas (Anon & Service Role Keys).
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Pública (Publishable Key "sb_publishable_..." ou legada Anon Key "eyJ...")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_seu_token_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_seu_token_aqui

# Chave Secreta de Servidor (Secret Key "sb_secret_..." ou legada Service Role Key "eyJ...")
SUPABASE_SECRET_KEY=sb_secret_seu_token_aqui
SUPABASE_SERVICE_ROLE_KEY=sb_secret_seu_token_aqui

# ============================================================================
# STRIPE (CHECKOUT DE DOAÇÕES ÚNICAS E MENSAIS — SEM NECESSIDADE DE WEBHOOK)
# ============================================================================
STRIPE_SECRET_KEY=sk_live_sua_chave_secreta_aqui
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_sua_chave_publica_aqui
